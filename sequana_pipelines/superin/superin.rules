    html_content += report_SI_table()
    html_content += report_SI_histogram()
    html_content += report_SI_localisation()
    html_content += report_fastx_links()


    manager.teardown()

    from sequana.modules_report.summary import SequanaReport

    data = manager.getmetadata()
    s = SequanaReport(data, html_content)

