
# The nanocap pipeline maps data onto reference, filter them, 
# create plots and provide final BAM files

# Here, we use the BAM files to create extra plots
# First, we filter the BAM files based on the plasmid used.

from sequana_pipetools import snaketools as sm
 
configfile: "config.yaml"
manager = sm.PipelineManager("superin", config)
expected_output = []

import pandas as pd
df = pd.read_csv(config["samplesheet"])
labels = df['sample']
if len(df.plasmid.dropna()):
    use_plasmids = True
else:
    use_plasmids = False

expected_output = [
        expand("SI/fastq/{label}_reads_with_deletions.fastq.gz", label=labels),
        expand("SI/fasta/{label}_reads_with_deletions.fasta.gz", label=labels),
        expand("SI/fastq/{label}_reads_with_insertions.fastq.gz", label=labels),
        expand("SI/fasta/{label}_reads_with_insertions.fasta.gz", label=labels),
        "nanocap_filtered_fastqs/stats.csv",
        "SI/position_deletions.png",
        "SI/position_insertions.png",
        "SI/distribution_entropy_of_deletions_insertions_on_SI.csv",
        ".sequana/rulegraph.svg",
]


if use_plasmids:
    expected_output += [
        "plasmids/deletions_insertions_stats.csv",
        expand("plasmids/{label}_deletions_distribution.png", label=labels),
        expand("plasmids/{label}_insertions_distribution.png",label=labels),
        "mapped_insertions_on_SI/insertions_summary.csv",
    ]

rule all:
    input:
        expected_output


super_integron_reference=config['SI_reference_file']

import pandas as pd
df = pd.read_csv(config["samplesheet"])
samples_plasmids = dict([(x,y) for x, y in zip(
                                                df["sample"].values, 
                                                df["plasmid"].values)
                        ])

samples_references = dict([(x,config['plasmids_directory'] + "/" + y) for x, y in zip(
                                                df["sample"].values, 
                                                df["reference"].values)
                        ])




def get_bam(wildcards):
    plasmid = samples_plasmids[wildcards.label]
    return f"filtered_BAM_files/{wildcards.label}.{plasmid}.sorted.bam"


def get_fasta(wildcards):
    label = wildcards.label
    return samples_references[label]

if use_plasmids:

    rule filter_nanocap_BAM:
        """Filter nanocap BAM to keep only those on the plasmid"""
        input:
            bam=config['input_bam_pattern'] + "/{label}.sorted.bam"
        output:
            bam="filtered_BAM_files/{label}.{plasmid}.sorted.bam",
            bai="filtered_BAM_files/{label}.{plasmid}.sorted.bam.bai"
        container:
            config['apptainers']['tools']
        log:
            "filtered_BAM_files/filter_nanocap_BAM.{label}.{plasmid}.log.txt"
        shell:
            """
            (
            samtools index {input.bam}
            samtools view -b -h {input.bam} {wildcards.plasmid} > {output.bam}
            samtools index {output.bam}
            ) >{log} 2>&1
            """

    rule scatter_plots:
        input: 
            bam = get_bam,
            fasta = get_fasta
        output:
            png_del="plasmids/{label}_deletions_distribution.png",
            csv_del="plasmids/{label}_deletions_distribution.csv",
            png_ins="plasmids/{label}_insertions_distribution.png",
            csv_ins="plasmids/{label}_insertions_distribution.csv",
            stats="plasmids/{label}_summary.csv"
        params:
            min_length=config["INDELs_filter"]["minimal_indel_length"]
        run:
            from sequana_pipelines.superin import tools
            import matplotlib
            matplotlib.use("Agg")
            from pylab import plot, savefig
            from sequana.viz import ScatterHist


            data, stats = tools.get_INDELs(input.bam, input.fasta, minimal_length_indels=params.min_length)

            plasmid = samples_plasmids[wildcards.label]
            import pysam
            with pysam.AlignmentFile(input.bam) as bam:
                plasmid_length = bam.get_reference_length(plasmid)

            for typ_, name in [('D', 'Deletion'), ('I', 'Insertion')]:

                try:
                    dd = data.query("typ==@typ_ and L>=@params.min_length")[['rpos', 'L']]
                except:
                    dd = data

                # axes limits adapted to the plasmid and to the data
                ymax = max(1000, int(dd['L'].max() * 1.1)) if len(dd) else 1000
                ymax = int(round(ymax, -2))

                im = ScatterHist(dd)
                ax0, axX, axY = im.plot(
                    kargs_scatter={'s': 20, 'c': 'b', 'alpha': 0.5},
                    offset_x=0.14,
                    kargs_histx={'bins': range(0, plasmid_length + 100, 100)},
                    kargs_histy={'bins': range(0, ymax + 100, 100)})
                ax0.set_xlim([0, plasmid_length])
                ax0.set_ylim([0, ymax])
                axX.set_xlim([0, plasmid_length])
                axY.set_ylim([0, ymax])
                axX.set_xticklabels([])
                axY.set_yticklabels([])

                ax0.set_xlabel(f"Position on {plasmid} (bp)")
                ax0.set_ylabel(f"{name} length (bp)")
                axX.yaxis.set_label_position("right")
                axX.set_ylabel("Count")
                axY.set_xlabel("Count")
                from matplotlib.ticker import MaxNLocator
                axX.yaxis.set_major_locator(MaxNLocator(integer=True))
                axY.xaxis.set_major_locator(MaxNLocator(integer=True))

                # read again to save more information
                try:
                    dd = data.query("typ==@typ_ and L>=@params.min_length")
                except:
                    dd = data

                if typ_ == 'D':
                    savefig(output.png_del, dpi=200)
                    dd.to_csv(output.csv_del, index=False)
                else:
                    savefig(output.png_ins, dpi=200)
                    dd.to_csv(output.csv_ins, index=False)

            # mean depth of coverage over the plasmid (same as 'meandepth' in samtools coverage)
            coverage = pysam.coverage("-r", plasmid, input.bam).strip().split("\n")[-1].split("\t")
            mean_coverage = int(round(float(coverage[6])))

            with open(output.stats, "w") as fout:
                fout.write(f"sample,nreads,insertion,deletion,mean_coverage\n{wildcards.label},{stats['N']},{stats['insertions']},{stats['deletions']},{mean_coverage}\n")


    rule gather_stats:
        input:
            summary = expand("plasmids/{label}_summary.csv", label=labels),
            on_SI = expand("mapped_insertions_on_SI/insertions_summary_SI_{label}.csv", label=labels)
        output:
            csv = "plasmids/deletions_insertions_stats.csv"
        run:
            import pandas as pd
            df = pd.concat([pd.read_csv(file) for file in input.summary], axis=0)
            df = df[['sample', 'nreads', 'insertion', 'deletion', 'mean_coverage']]
            df.columns = ['sample', 'mapped_reads', 'insertions', 'deletions', 'mean_coverage']
            # reads of the insertions that map back on the SI (flags 0, 16): one row per read
            df['insertions_on_SI'] = [len(pd.read_csv(file)) for file in input.on_SI]
            df.to_csv(output.csv, index=False)


    # from mapped data, identify insertions on plasmid to map back later
    # on the SI.
    rule save_plasmid_insertions_in_fastq:
        input:
            bam = get_bam,
            fasta = get_fasta,
            fastq = config["input_directory"] + "/{label}.fastq.gz"
        output:
            fastq = "mapped_insertions_on_SI/insertions_{label}.fastq"
        params:
            min_length=config["INDELs_filter"]["minimal_indel_length"]
        run:
            from sequana_pipelines.superin import tools
            from sequana import FastQ
            df, stats = tools.get_INDELs(input.bam, input.fasta, params.min_length)
            try:
                identifiers = df.query("typ=='I'").qname.values
                f = FastQ(input.fastq)
                f.select_reads(identifiers, output.fastq)
            except:
                with open(output.fastq, "w") as fout:
                    seq = "G" * 80
                    fout.write(f">dummy\n{seq}\n+\n{seq}")


rule mapped_on_SI:
    """map the nanocap output files onto the SI only"""
    input:
        fastq = config['input_directory'] + "/{label}.fastq.gz",
        reference=super_integron_reference
    output:
        bam="SI/{label}.sorted.bam"
    threads: config["minimap2"]["threads"]
    params:
        options=config["minimap2"]["options"]
    container:
        config['apptainers']['tools']
    log:
        "SI/mapped_on_SI.{label}.log.txt"
    shell:
        manager.get_shell("minimap2/align", "v1")


rule index_SI_bam:
    input:
        bam=rules.mapped_on_SI.output.bam
    output:
        bai="SI/{label}.sorted.bam.bai"
    container:
        config['apptainers']['tools']
    log:
        "SI/index_SI_bam.{label}.log.txt"
    shell:
        "samtools index {input.bam} >{log} 2>&1"

if use_plasmids:
    rule map_back_insertions_on_SI:
        input:
            fastq=rules.save_plasmid_insertions_in_fastq.output.fastq,
            reference=super_integron_reference
        output:
            bam = "mapped_insertions_on_SI/insertions_{label}.sorted.bam"
        threads: config["minimap2"]["threads"]
        params:
            options=config["minimap2"]["options"]
        container:
            config['apptainers']['tools']
        log:
            "mapped_insertions_on_SI/map_back_insertions_on_SI.{label}.log.txt"
        shell:
            manager.get_shell("minimap2/align", "v1")

    rule index_insertions_bam:
        input:
            bam=rules.map_back_insertions_on_SI.output.bam
        output:
            bai = "mapped_insertions_on_SI/insertions_{label}.sorted.bam.bai"
        container:
            config['apptainers']['tools']
        log:
            "mapped_insertions_on_SI/index_insertions_bam.{label}.log.txt"
        shell:
            "samtools index {input.bam} >{log} 2>&1"

    rule ind_insertions_stats:
        input:
            bam=rules.map_back_insertions_on_SI.output.bam
        output:
            csv="mapped_insertions_on_SI/insertions_summary_SI_{label}.csv"
        run:
            from sequana import BAM
            b = BAM(input.bam)
            tempdf = b.get_df().query("flag in [0,16]")
            tempdf.to_csv(output.csv, sep=',', index=False)

    rule insertion_stats:
        input:
            expand(
                "mapped_insertions_on_SI/insertions_summary_SI_{label}.csv",
                label=labels)
        output:
            csv="mapped_insertions_on_SI/insertions_summary.csv"
        run:
            import pandas as pd
            data = pd.concat([pd.read_csv(x) for x in input], axis=0)
            data.to_csv(output.csv, index=False)


rule get_excision:
    """excision found in SI as deletions

    Here the input is the3 nanocap output (filtered for low quality reads)
    """
    input:
        bam=rules.mapped_on_SI.output.bam,
        bai=rules.index_SI_bam.output.bai,
        fasta=super_integron_reference
    output:
        png="SI/distribution_entropy_of_deletions_insertions_on_SI_{label}.png",
        png_hist_del="SI/hist_deletions_on_SI_{label}.png",
        json="SI/distribution_entropy_of_deletions_insertions_on_SI_{label}.json",
        csv_del="SI/summary_deletions_{label}.csv",
        csv_ins="SI/summary_insertions_{label}.csv"
    params:
        entropy=config['INDELs_filter']['entropy_above'],
        start_position=config['INDELs_filter']['SI_start_position'],
        min_length=config['INDELs_filter']['minimal_indel_length']
    run:
        import matplotlib
        matplotlib.use('Agg')
        from pylab import xlabel, ylabel, legend, savefig, plot, clf
        from sequana_pipelines.superin import tools
        from numpy import linspace
        deletions, stats = tools.get_INDELs(input.bam, input.fasta, 
            minimal_length_indels=params.min_length)
        stats['sample'] = wildcards.label

        if len(deletions):
            deletions.query("typ=='I'").entropy.hist(alpha=0.5, density=True,
                bins=linspace(0,1.5,100), label='insertion')
            deletions.query("typ=='D'").entropy.hist(alpha=0.5, density=True,
                bins=linspace(0,1.5,100), label='deletion')
            xlabel('entropy')
            legend()
            savefig(output.png)
        
            # save deletions
            DEL = deletions.query("entropy>@params.entropy and typ=='D' and rpos>@params.start_position")[['qpos', 'L', 'rpos', 'sequence', 'qname', 'entropy']]
            DEL.to_csv(output.csv_del , index=False)
            clf()
            DEL.L.hist(bins=50)
            savefig(output.png_hist_del)


            IN = deletions.query("entropy>@params.entropy and typ=='I' and rpos>@params.start_position")[['qpos', 'L', 'rpos', 'sequence', 'qname', 'entropy']]
            IN.to_csv(output.csv_ins , index=False)
            stats['filtered_deletions'] = len(DEL)
            stats['filtered_insertions'] = len(IN)
            stats['percent_filtered_deletions'] = round(len(DEL) / stats['N'] * 100,3)
            stats['percent_filtered_insertions'] = round(len(IN) / stats['N'] * 100,3)

        else:
            plot([0],[0])
            savefig(output.png)

            # save empty deletions file

        # save a common json file
        import pandas as pd
        import json
        with open(output.json, 'w') as fout:
            json.dump(stats, fout)


rule create_SI_images_INDELs_positions:
    input:
        expand("SI/summary_deletions_{label}.csv", label=labels),
        expand("SI/summary_insertions_{label}.csv", label=labels)
    output:
        deletions="SI/position_deletions.png",
        insertions="SI/position_insertions.png"
    run:
        import pandas as pd
        from pylab import legend, savefig, clf
        import matplotlib
        matplotlib.use('Agg')
        for label in labels:
            df = pd.read_csv(f"SI/summary_deletions_{label}.csv")
            df.rpos.hist(bins=200, label=label)
        legend()
        savefig(output.deletions)
        clf()
        for label in labels:
            df = pd.read_csv(f"SI/summary_insertions_{label}.csv")
            df.rpos.hist(bins=200, label=label)
        legend()
        savefig(output.insertions)



rule get_excision_stats:
    input:
        json = expand(
            "SI/distribution_entropy_of_deletions_insertions_on_SI_{label}.json",
            label=labels)
    output:
        csv = "SI/distribution_entropy_of_deletions_insertions_on_SI.csv"
    run:
        import pandas as pd
        data = pd.concat([pd.read_json(x, typ='series') for x in input.json], axis=1)
        data.columns = labels
        data = data.T
        data.to_csv(output.csv, index=False)


rule get_fastq_fasta_deletions:
    input:
        csv=rules.get_excision.output.csv_del,
        fastq = config["input_directory"] + "/{label}.fastq.gz",
    output:
        fastq="SI/fastq/{label}_reads_with_deletions.fastq.gz",
        fasta="SI/fasta/{label}_reads_with_deletions.fasta.gz"
    run:
        import pandas as pd
        from sequana_pipelines.superin import tools
        identifiers = pd.read_csv(input.csv)['qname'].values
        tools.select_reads_gz(input.fastq, identifiers, output.fastq, output.fasta)



rule get_fastq_fasta_insertions:
    input:
        csv=rules.get_excision.output.csv_ins,
        fastq = config["input_directory"] + "/{label}.fastq.gz",
    output:
        fastq="SI/fastq/{label}_reads_with_insertions.fastq.gz",
        fasta="SI/fasta/{label}_reads_with_insertions.fasta.gz"
    run:
        import pandas as pd
        from sequana_pipelines.superin import tools
        identifiers = pd.read_csv(input.csv)['qname'].values
        tools.select_reads_gz(input.fastq, identifiers, output.fastq, output.fasta)








rule individual_fastq_stats:
    input:
        fastq=config["input_directory"] +"/{label}.fastq.gz"
    output:
        json="nanocap_filtered_fastqs/{label}.json"
    run:
        from sequana import FastQ
        f = FastQ(input.fastq)
        stats = f.stats()
        stats['sample'] = wildcards.label
        from sequana_pipelines.superin import tools
        tools.save_json(output.json, stats)


rule fastq_stats:
    input:
         json=expand(
            "nanocap_filtered_fastqs/{label}.json", label=labels)
    output:
        csv="nanocap_filtered_fastqs/stats.csv"
    run:
        import pandas as pd
        data = pd.concat([pd.read_json(x, typ='series') for x in input.json], axis=1)
        data = data.T
        data.set_index("sample", inplace=True)
        data.to_csv(output.csv, index=True)

rule rulegraph:
    input:
        workflow.snakefile,
    output:
        "rulegraph/rulegraph.dot",
    params:
        configname="config.yaml",
        mapper = {},
    run:
        manager.get_run("rulegraph/run", "v1")(input, output, params)


rule dot2svg:
    input:
        "rulegraph/rulegraph.dot"
    output:
        ".sequana/rulegraph.svg"
    container:
        config['apptainers']['graphviz']
    shell:
        manager.get_shell("graphviz/dot2svg", "v1")


localrules: rulegraph, dot2svg


########################################################################33



def get_SI_images_html():

    html  = '<div class="image-grid">'
    for label in labels:
        html +=f'<figure><img src="SI/distribution_entropy_of_deletions_insertions_on_SI_{label}.png"><figcaption>{label}</figcaption></figure>'
    html += '</div>'

    return html

def get_html_table(df, name, index=False, filename="data.csv"):
    from sequana.utils.datatables_js import DataTable
    dt = DataTable(df, name, index=index)
    dt.datatable.datatable_options = {'pageLength': 10,
                                       'dom': 'Brt',
                                        'filename': filename,
                    'order':[],
                                       'buttons': ['copy', 'csv']}
    return dt.create_javascript_function() +  dt.create_datatable()


def report_intro():
    return """
    <p>We first run the <a href="https://github.com/sequana/nanocap">Nanocap pipeline</a>
    to map the Nanopore data onto the references to be found in <a href="./references">directory</a> depending on the sample, as described here below. The BAM files </p>
    """


def report_sample_information():

    from sequana import FastA
    html = "<p> Here is the correspondance of samples and plasmids used. </p>"
    # sample information
    samples = sorted(samples_plasmids.keys())
    df = pd.DataFrame({
            'sample': samples, 
            'plasmid': [samples_plasmids[x] for x in samples],
            'reference': [os.path.relpath(samples_references[x]) for x in samples]
        })
    #Get plasmids size and therefore length to estimate coverage
    lengths = {}
    for name, ref in zip(df['plasmid'], df['reference']):
        f = FastA(ref)
        lengths.update(f.get_lengths_as_dict())
    df['size'] = [lengths[x] for x in df['plasmid']]
    html += get_html_table(df, "info")

    return html

def report_plasmids_scatter_plots():
    # scatter plots
    html = '<h3 id="plasmid_insertions">Insertions</h3>'
    html += '<div class="image-grid">'
    for label in labels:
        html += f'<figure><img src="plasmids/{label}_insertions_distribution.png"><figcaption>{label}</figcaption></figure>'
    html += '</div>'

    html += '<h3 id="plasmid_deletions">Deletions</h3>'
    html += '<div class="image-grid">'
    for label in labels:
        html += f'<figure><img src="plasmids/{label}_deletions_distribution.png"><figcaption>{label}</figcaption></figure>'
    html += '</div>'

    return html


def get_html_plasmid_stats():

    # stats on plasmids
    stats = pd.read_csv(rules.fastq_stats.output.csv)
    stats = stats.reset_index()
    stats = stats[["sample", 'N', 'mean_length']]
    stats["mean_length"] = [int(x) for x in stats.mean_length.values]
    stats.columns = ["sample", "Number of reads (>1000bp)", "Mean read length (>1000bp)"]
    # mean depth of coverage on the plasmid (from the plasmid-filtered BAM files)
    coverage = pd.read_csv(rules.gather_stats.output.csv)[["sample", "mean_coverage"]]
    coverage.columns = ["sample", "Mean coverage on plasmid"]
    stats = stats.merge(coverage, on="sample", how="left")
    table_html_mapped_reads_plasmids = get_html_table(stats, "stats_plasmids")
    return table_html_mapped_reads_plasmids

def report_plasmids_description():

    html_info_INDELs = """
We extract the INDELs from the BAM files, filtered INDELs with size below 100bp to keep only the largest ones. We save information about the deletions and insertions in CSV files that are provided in the <a href="./plasmids">plasmids/</a> directory. They are called SAMPLE_deletions_distribution.csv and SAMPLE_insertions_distribution.csv an. They are in CSV format with this header/example
    
    <pre>    typ,qpos,L,rpos,sequence,qname,rname,entropy
    D,4994,857,4532,TCAGAACTTT...,7e95b8e9-86d7-492a-91f6-5fab173b671f,2,1.3856637221270693
    </pre>
    <br>
    where columns are as follows:
    <ul>
        <li>'typ' is D for deletion, I for insertion</li>
        <li>qpos the position on the read </li>
        <li>L the size of the deletionsi/inserions</li>
        <li>rpos is the position on the reference</li>
<li>sequence is the insertion/deletion nucleotide sequence. deletion is inferred from the reference. </li>
<li>qname, the unique identifier of the read (raw nanopore).</li>
<li> rname is the reference index.</li>
<li> entropy is the entropy of the sequence.  </li>
</ul>

We can look at the distributions of the insertions and deletions for each sample within the following parameter space: position on the plasmid versus length of the INDEL. In the scatter plot that follows we can see that insertions are localised on the plasmid and have imilar length while deletions are rare. 
    """
    return html_info_INDELs

def report_plasmid_section():

    table_html_mapped_reads_plasmids = get_html_plasmid_stats()

    # example with the first sample: the BAM file is mapped on the reference of its plasmid
    sample = sorted(samples_plasmids.keys())[0]
    plasmid = samples_plasmids[sample]
    reference = os.path.relpath(samples_references[sample])
    igv_example = f"igv -g {reference}  filtered_BAM_files/{sample}.{plasmid}.sorted.bam"

    html = f"""
    <p>We first filtered the BAM files from Nanocap to keep the reads that map on the plasmids. Those files are in the directory  
    <a href="filtered_BAM_files">filtered_BAM_files</a> and can be visualised e.g. using<br>
    <br><pre>
    {igv_example}
    </pre>
    The following table gives the number of reads and their mean length after filtering for reads with length below 1000bp, and the mean depth of coverage on the plasmid (from the filtered BAM files). See nanocap reports for more details.
    </p>
    {table_html_mapped_reads_plasmids}
    """
    return html

def report_plasmids_summary():
    min_length = config["INDELs_filter"]["minimal_indel_length"]
    df = pd.read_csv(rules.gather_stats.output.csv).drop(columns="mean_coverage")

    html = '<h3 id="plasmid_summary">Summary</h3>'
    html += f"""
    <p>The following table summarises the INDELs found on the plasmids (also available in
    <a href="./plasmids/deletions_insertions_stats.csv">plasmids/deletions_insertions_stats.csv</a>):</p>
    <ul>
    <li><b>mapped_reads</b>: number of reads mapped on the plasmid reference as primary alignments
        (SAM flags 0 and 16), i.e. without secondary or supplementary alignments. Only those reads
        are used to search for INDELs.</li>
    <li><b>insertions</b> and <b>deletions</b>: number of insertions (resp. deletions) found in those
        reads that are longer than {min_length} bp. A read may contain several INDELs.</li>
    <li><b>insertions_on_SI</b>: the insertion sequences were extracted and mapped back onto the SI.
        This is the number of those reads that map (flags 0 and 16).
        See the directory <a href="./mapped_insertions_on_SI">mapped_insertions_on_SI</a>.</li>
    </ul>
    """
    html += get_html_table(df, "stast_indels", )
    return html


def report_SI_intro():
    cfg = config["INDELs_filter"]
    html = f"""
    <p>An insertion found in a plasmid corresponds to an excision in the SI. A read that maps on the plasmid has
    the structure P1-I-P2, where P1 and P2 are two parts of the plasmid and I the inserted sequence. Such a read does not
    map well on the SI since P1 and P2 are not found in the SI. Deletions are therefore simply extracted from the
    BAM files obtained by mapping the reads onto the SI only (reads of type SI1-D-SI2). From these alignments, we know
    the positions and the sequences of the deleted regions. In addition, the insertions found on the plasmids are mapped
    back onto the SI to figure out where they come from (see the column <b>insertions_on_SI</b> of the summary table above).</p>

    <p>The reads (longer than 1000 bp) are mapped onto the SI. Only the reads mapped with the SAM flags 0 and 16 are used. The INDELs
    are then selected using the following parameters, defined in the section <code>INDELs_filter</code> of the
    configuration file <code>config.yaml</code>:</p>
    <ul>
    <li><b>minimal_indel_length = {cfg["minimal_indel_length"]}</b>: only the INDELs longer than {cfg["minimal_indel_length"]} bp are kept.</li>
    <li><b>entropy_above = {cfg["entropy_above"]}</b>: some INDELs are artefacts with a low-complexity sequence
        (e.g., GTGTGTGTGTGT), most probably nanopore errors. We compute the Shannon entropy of each INDEL sequence
        (natural logarithm, between 0 and ln(4)=1.39 for the 4 nucleotides) and ignore the INDELs with an entropy
        lower than {cfg["entropy_above"]}. The figures below show the entropy distributions of the insertions and deletions;
        most of the low-entropy INDELs are insertions.</li>
    <li><b>SI_start_position = {cfg["SI_start_position"]}</b>: the INDELs located before the position
        {cfg["SI_start_position"]} on the SI reference are ignored. </li>
    </ul>
    """

    return html

def report_SI_stats():
    html = ""

    df = pd.read_csv("SI/distribution_entropy_of_deletions_insertions_on_SI.csv")
    df["mapped reads"] = df['N']
    df = df.set_index('sample').T
    df = df.loc[[
            'mapped reads',
            'insertions',
            'deletions',
            'percent_insertions',
            'percent_deletions',
            'filtered_deletions',
            'filtered_insertions',
            'percent_filtered_insertions',
            'percent_filtered_deletions',
        ]]
    html += get_html_table(df, "stats_SI", index=True)
    return html

def report_SI_table():

    html_SI_stats = report_SI_stats()
    cfg = config["INDELs_filter"]

    html = f"""
    <p>The following table gives the number of INDELs found on the SI for each sample (rows):</p>
    <ul>
    <li><b>mapped reads</b>: number of reads mapped on the SI (flags 0 and 16).</li>
    <li><b>insertions</b>, <b>deletions</b>: number of insertions (resp. deletions) longer than
        {cfg["minimal_indel_length"]} bp. <b>percent_insertions</b>, <b>percent_deletions</b>: same numbers
        in percentage of the mapped reads.</li>
    <li><b>filtered_insertions</b>, <b>filtered_deletions</b>: number of insertions (resp. deletions) that
        pass all the filters: length &gt; {cfg["minimal_indel_length"]} bp, entropy &gt; {cfg["entropy_above"]}
        and position on the SI &gt; {cfg["SI_start_position"]}. <b>percent_filtered_insertions</b>,
        <b>percent_filtered_deletions</b>: same numbers in percentage of the mapped reads.</li>
    </ul>

    Download <a href="SI/distribution_entropy_of_deletions_insertions_on_SI.csv">SI stats</a> CSV file.

    {html_SI_stats}
    """
    return html

def report_SI_histogram():

    # ====================== add images with deletion length histogram (on SI)
    html  = '<div class="image-grid">'
    for label in labels:
        html +=f'<figure><img src="SI/hist_deletions_on_SI_{label}.png"><figcaption>{label}</figcaption></figure>'
    html += '</div>'
    return html

def report_SI_localisation():

    # ========================== add figures about the localisation of the INDELs (on SI)
    import numpy as np
    import plotly.express as px

    def load(typ):
        df = pd.concat([pd.read_csv(f"SI/summary_{typ}_{label}.csv").assign(label=label) for label in labels])
        # a deletion spans [rpos, rpos+L]; an insertion has a single position on the SI
        df["end"] = df["rpos"] + df["L"] if typ == "deletions" else df["rpos"]
        return df

    # same colors for a given sample in all the figures
    colors = {label: px.colors.qualitative.Plotly[i % 10] for i, label in enumerate(labels)}
    orders = {"label": list(labels)}

    # same x axis limits in all the figures: the whole SI reference
    import pysam
    with pysam.FastaFile(super_integron_reference) as fasta:
        SI_length = fasta.lengths[0]

    def track(df, ylabel, step):
        """number of INDELs per position of the SI (bins of 'step' bp) and per sample

        A deletion is counted in all the bins between its start and its end. An insertion is counted in
        the bin where it is located.
        """
        nbins = SI_length // step + 2
        rows = []
        for label in labels:
            sub = df.query("label == @label")
            diff = np.zeros(nbins + 1)
            np.add.at(diff, (sub["rpos"] // step).astype(int), 1)
            np.add.at(diff, (sub["end"] // step).astype(int) + 1, -1)
            rows.append(pd.DataFrame({"position": np.arange(nbins) * step, "count": np.cumsum(diff)[:nbins], "label": label}))
        fig = px.line(
            pd.concat(rows),
            x="position",
            y="count",
            color="label",
            color_discrete_map=colors,
            category_orders=orders,
            line_shape="hv",
            labels={"position": "Position on the SI (bp)", "count": ylabel, "label": "Sample"},
        )
        fig.update_xaxes(range=[0, SI_length])
        div = fig.to_html(full_html=False, include_plotlyjs="cdn")
        return div

    html = '<h3 id="SI_localisation">Localisation INDELs on SI</h3>'
    html += """
    <p>Only the INDELs passing the filters described above are shown. The figures are drawn in bins along the SI
    reference (100 bp for the deletions, 1000 bp for the insertions, which are less numerous). A read may contain several INDELs.</p>
    """

    html += "<h4>Deletions</h4>"
    html += "<figure>" + track(load("deletions"), "Number of deletions covering the position", step=100) + """
    <figcaption>Number of deletions covering each position of the SI (bins of 100 bp). A deletion is counted at all the positions between
    its start and its end. Peaks show the regions that are frequently excised; the width of a peak reflects the size of
    the deletions.</figcaption></figure>"""

    html += "<h4>Insertions</h4>"
    html += "<figure>" + track(load("insertions"), "Number of insertions per 1000 bp", step=1000) + """
    <figcaption>Number of insertions found in each bin of 1000 bp of the SI. An insertion has a single position
    on the reference.</figcaption></figure>"""
    return html


def report_fastx_links():

    # Links towards the fastq

    html = 'FastQ an FastA file were creating by extacting reads with INDELs found on the SI (size >100bp)'
    html+="""<ul>
    <li>
    FastQ with the reads found with insertions on the SI are in <a href="./SI/fastq">directory</a> 
    </li>
    <li>
    FastA with the reads found with insertions on the SI are in <a href="./SI/fasta">directory</a>
    </li>
    <li>
    FastQ with the reads found with deletions on the SI are in <a href="./SI/fastq">directory</a>
    </li>
    <li>
    FastA with the reads found with deletions on the SI are in <a href="./SI/fasta">directory</a>
    </li>
    </ul>
    """
    return html


onsuccess:


    # ======================================== final HTML report
    # Each section is declared in the sections of the report so that it appears (with its subsections)
    # in the table of contents (sidebar). The title of a section is added by the report template.
    from sequana.utils import config as report_config

    sections = []
    if use_plasmids:
        sections.append({"name": "Sample information", "anchor": "info", "content": report_sample_information()})
        sections.append({"name": "Number of reads of interest", "anchor": "read_stats", "content": report_plasmid_section()})
        sections.append({
            "name": "Insertions/Deletions on the plasmids",
            "anchor": "plasmid_indels",
            "content": report_plasmids_description() + report_plasmids_scatter_plots() + report_plasmids_summary(),
            "subsections": [
                ("Insertions", "plasmid_insertions"),
                ("Deletions", "plasmid_deletions"),
                ("Summary", "plasmid_summary"),
            ],
        })

    sections.append({
        "name": "Mapping back INDELs on the SI",
        "anchor": "SI",
        "content": (report_SI_intro() + get_SI_images_html() + report_SI_table()
                    + report_SI_histogram() + report_SI_localisation()),
        "subsections": [("Localisation INDELs on SI", "SI_localisation")],
    })
    sections.append({"name": "FastQ and FastA files", "anchor": "fastq", "content": report_fastx_links()})

    report_config.summary_sections = sections

    manager.teardown()

    from sequana.modules_report.summary import SequanaReport

    data = manager.getmetadata()
    s = SequanaReport(data, report_intro())

    ## Save to file
